{
  "name": "@cloudvisionapps/react-ui",
  "version": "2.0.2",
  "description": "A comprehensive React UI component library",
  "author": "CloudVisionApps",
  "homepage": "https://github.com/CloudVisionApps/ReactUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudVisionApps/ReactUI.git"
  },
  "bugs": {
    "url": "https://github.com/CloudVisionApps/ReactUI/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.8",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && npm run build:css",
    "build:css": "mkdir -p dist && npx tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "dev": "rollup -c -w",
    "preview": "vite preview --port 3000",
    "preview:dev": "vite --port 3000",
    "build:preview": "npm run build && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "pack:check": "npm pack --dry-run",
    "release": "npm run release:patch",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "library",
    "design-system",
    "tailwindcss",
    "typescript",
    "component-library",
    "react-components"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.3.2",
    "tslib": "^2.6.2",
    "vite": "^5.0.5",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "lucide-react": "^0.460.0",
    "yaml": "^2.8.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  }
}
